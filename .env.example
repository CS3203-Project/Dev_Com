# Railway Deployment Environment Variables

# Runtime Configuration
NODE_ENV=production
PORT=3001

# External RabbitMQ Configuration (CloudAMQP example)
RABBITMQ_URL=amqps://your-cloudamqp-url

# Database Configuration (Railway or external PostgreSQL)
DATABASE_URL=your-database-connection-string

# Email Configuration (Gmail example)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password

# Message Encryption (REQUIRED - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# This key must be a 64-character hexadecimal string (256-bit AES key)
# Keep this key secure and consistent across deployments
ENCRYPTION_KEY=your-64-character-hex-encryption-key-here

# Note: Replace placeholder values with actual service credentials
# All these variables should be set in Railway dashboard
# ENCRYPTION_KEY is critical for message security
