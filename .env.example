# Railway Deployment Environment Variables

# Runtime Configuration
NODE_ENV=production
PORT=3001

# External RabbitMQ Configuration (CloudAMQP example)
RABBITMQ_URL=amqps://your-cloudamqp-url

# Database Configuration (Railway or external PostgreSQL)
DATABASE_URL=your-database-url

# Email Configuration (Gmail example)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password

# Note: Replace placeholder values with actual service credentials
# All these variables should be set in Railway dashboard
